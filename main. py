import os
from telegram import Update
from telegram.ext import ApplicationBuilder, MessageHandler, filters, ContextTypes
import yt_dlp

TOKEN = os.environ.get("TOKEN")

ALLOWED = ["youtube.com","youtu.be","tiktok.com","instagram.com","facebook.com","fb.watch","spotify.com"]

async def handle(update: Update, context: ContextTypes.DEFAULT_TYPE):
    url = update.message.text.strip()
    if not url.startswith("http"):
        return
    m = await update.message.reply_text("⏳ بحمل...")
    try:
        if "spotify" in url:
            opts = {'format':'bestaudio/best','outtmpl':'audio.%(ext)s','postprocessors':[{'key':'FFmpegExtractAudio','preferredcodec':'mp3'}],'quiet':True}
            with yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(url, download=True)
            await update.message.reply_audio(audio=open("audio.mp3",'rb'), title=info.get('title',''))
            os.remove("audio.mp3")
        else:
            vopts = {'format':'best[ext=mp4]/best','outtmpl':'video.%(ext)s','noplaylist':True,'quiet':True}
            with yt_dlp.YoutubeDL(vopts) as ydl:
                info = ydl.extract_info(url, download=True)
            vfile = "video.mp4"
            if not os.path.exists(vfile):
                for f in os.listdir("."):
                    if f.startswith("video."): vfile=f
            os.system(f'ffmpeg -i "{vfile}" -vn -c:a libmp3lame voice.mp3 -y -loglevel quiet')
            await update.message.reply_video(video=open(vfile,'rb'), caption=info.get('title',''))
            await update.message.reply_voice(voice=open("voice.mp3",'rb'))
            os.remove(vfile); os.remove("voice.mp3")
        await m.delete()
    except Exception as e:
        print(e)
        await update.message.reply_text("فشل، جرب لينك تاني")

app = ApplicationBuilder().token(TOKEN).build()
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle))
app.run_polling()
